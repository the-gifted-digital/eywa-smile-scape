---
import Landing from '~/layouts/Landing.astro';

const LINE_URL = 'https://maac.io/6yp2p';
const PHONE_TEL = '+66922936226';

const title = 'รากฟันเทียม Blue Diamond เริ่ม 29,900฿ (รวมครอบฟัน) | SmileScape';
const description =
  'รากฟันเทียม Blue Diamond นำเข้าเกาหลี เริ่ม 29,900฿ รวมครอบฟัน · ผ่อน 0% 10 เดือน ไม่ต้องใช้บัตร · รับประกันตลอดอายุการใช้งาน · ทันตแพทย์เฉพาะทางศัลยฯ มหิดล · 2 สาขาติด MRT';

// 8 real before/after case photos pulled from the original page.
const beforeAfter = [
  '/images/lp/review1.jpg',
  '/images/lp/review2.jpg',
  '/images/lp/review3.jpg',
  '/images/lp/review4.jpg',
  '/images/lp/review5.png',
  '/images/lp/review6.png',
  '/images/lp/review7.png',
];

const included = [
  'ราคารวมครอบฟันคุณภาพแล้ว',
  'ผ่อน 0% นานสูงสุด 10 เดือน — แม้ไม่มีบัตรเครดิต',
  'ฟรี! ตรวจและวางแผนการรักษากับทันตแพทย์เฉพาะทาง',
  'รับประกันตัวรากฟัน ตลอดอายุการใช้งาน',
  'ดูแลโดยทันตแพทย์เฉพาะทางที่มีประสบการณ์',
];

const why = [
  { t: 'Blue Diamond นำเข้าเกาหลี', d: 'รากฟันเทียมตัว Top คุณภาพจัดเต็ม วัสดุไทเทเนียมเกรดการแพทย์ เข้ากับร่างกายได้ดี ปลอดภัย' },
  { t: 'รับประกันตลอดอายุการใช้งาน', d: 'มั่นใจระยะยาว ดูแลใกล้ชิดหลังการรักษา ติดตามผลทุกขั้นตอน' },
  { t: 'ผ่อน 0% ไม่ต้องใช้บัตร', d: 'แบ่งชำระสบาย นานสูงสุด 10 เดือน เริ่มต้นการรักษาได้ทันที' },
  { t: 'ทันตแพทย์เฉพาะทาง มหิดล', d: 'ฝังรากโดยทันตแพทย์เฉพาะทางศัลยศาสตร์ช่องปากและแม็กซิลโลเฟเชียล' },
];

const steps = [
  { n: '1', t: 'นัดหมาย จองคิว', d: 'ติดต่อคลินิก เลือกวันเวลาที่สะดวก นัดหมายปรึกษากับทันตแพทย์เฉพาะทางศัลยศาสตร์ช่องปากและแม็กซิลโลเฟเชียล', img: '/images/lp/step1.png' },
  { n: '2', t: 'ปรึกษา ตรวจฟันละเอียด', d: 'เข้ามาพบทันตแพทย์เฉพาะทางเพื่อปรึกษาปัญหาที่กังวลใจ และตรวจฟันอย่างละเอียดด้วยการ X-ray, CT หรือ Scan ช่องปาก', img: '/images/lp/step2.png' },
  { n: '3', t: 'วางแผนการรักษา', d: 'เมื่อตรวจและทราบความกังวลใจเกี่ยวกับปัญหาแล้ว ทันตแพทย์เฉพาะทางวางแผนการรักษาอย่างละเอียด เพื่อให้ได้ผลการรักษาที่มีประสิทธิภาพและความพึงพอใจสูงสุด โดยไม่มีค่าใช้จ่าย', img: '/images/lp/step3.png' },
  { n: '4', t: 'ฝังรากฟันเทียม', d: 'ฝังรากฟันเทียม และชำระค่ารักษาส่วนแรก หลังจากนั้นรอกระดูกยึดติดกับรากฟันเทียมประมาณ 3 เดือน', img: '/images/lp/step4.png' },
  { n: '5', t: 'ใส่ครอบฟัน', d: 'เมื่อกระดูกยึดติดกับรากฟันเทียมดีแล้ว นัดหมายเพื่อใส่ครอบฟันคุณภาพสูง สีเหมือนฟันจริง และชำระค่าบริการส่วนที่เหลือ', img: '/images/lp/step5.png' },
];

const cases = [
  {
    t: 'ฝังรากฟันเทียม กรณีที่มีฟันหายไปเพียง 1 – 2 ซี่',
    d: 'ทำได้ 2 วิธี คือการทำรากฟันเทียม และสะพานฟัน แต่การทำรากฟันเทียมเป็นวิธีใส่ฟันที่ได้ผลดีที่สุด และยังมีข้อดีมากกว่าการใส่สะพานฟัน เพราะไม่ต้องกรอฟันข้างเคียง ทำความสะอาดได้ง่ายกว่า ส่วนวิธีสะพานฟันจะมีส่วนครอบของฟันติดกันทั้งหมด',
    img: '/images/lp/case1.png',
  },
  {
    t: 'ฝังรากฟันเทียม กรณีที่มีฟันหายไปเป็นจำนวนมาก',
    d: 'รากฟันเทียมจะช่วยให้ฟันเทียมแบบถอดได้แน่นขึ้น โดยไม่จำเป็นต้องใส่ตะขอฟันปลอม หรือทำให้ส่วนของเหงือกปลอมสั้นลง',
    img: '/images/lp/case2.png',
  },
  {
    t: 'ฝังรากฟันเทียม กรณีที่มีฟันหายไปทั้งปาก (ทำรากฟันเทียมทั้งปาก)',
    d: 'รากฟันเทียมสามารถช่วยทดแทนฟันได้ทั้งแบบติดแน่นและแบบถอดได้ โดยแบบติดแน่นทันตแพทย์จะฝังรากเทียมจำนวน 4, 6 หรือ 8 ตัวต่อ 1 ขากรรไกร ส่วนแบบถอดได้จะฝังรากฟันเทียมจำนวน 2 – 4 ตัว',
    img: '/images/lp/case3.png',
  },
];

const indications = [
  'มีความหนาของกระดูกเพียงพอ สันเหงือกมีช่องว่าง ตั้งแต่ 1 ซี่ ขึ้นไป',
  'มีสุขภาพร่างกายสมบูรณ์ แข็งแรง ไม่มีโรคประจำตัวที่มีผลต่อการสร้างกระดูก',
  'มีสุขอนามัยภายในช่องปากที่ดี สุขภาพช่องปากแข็งแรง ไม่เป็นโรคเหงือก',
  'ไม่มีประวัตินอนกัดฟัน หากมี อาจจำเป็นต้องตรวจเพิ่มเติมอย่างละเอียด',
  'ไม่สูบบุหรี่',
];

const benefits = [
  'ไม่ทำให้ฟันและเหงือกบริเวณใกล้ๆ เป็นอันตราย',
  'สันกระดูกเหงือกลดการละลายตัว',
  'สุขภาพปากและฟันดี เพราะง่ายต่อการทำความสะอาด',
  'การเคี้ยวอาหาร การพูด ดีขึ้น และมีประสิทธิภาพ',
  'เสริมบุคลิกภาพ เสริมความมั่นใจ',
  'อายุการใช้งานยาวนาน เมื่อเทียบกับการรักษาด้วยวิธีอื่น ๆ เช่น การใช้ฟันปลอมแบบชั่วคราว',
];

const limitations = [
  'อาจรู้สึกเจ็บหรือปวดขณะทันตแพทย์ทำการรักษา ในกรณีที่เจ็บปวดมากและกังวลมาก ทันตแพทย์อาจพิจารณาใช้ยาชาเฉพาะที่เพื่อระงับความปวดเพิ่มเติม',
  'การรักษามีหลายขั้นตอน อาจใช้เวลานาน 3 – 6 เดือน หรืออาจมากถึง 1 ปี แล้วแต่กรณี ขึ้นกับเงื่อนไขที่แตกต่างกันในแต่ละบุคคล และบริเวณที่ต้องปลูกกระดูกเพิ่มเติม',
  'หากพบปัญหาจากการฝังรากเทียม มักต้องแก้ไขด้วยการผ่าตัด',
  'การปักรากเทียมอาจมีหลายปัจจัยที่ควบคุมไม่ได้ เช่น ลักษณะทางกายภาพของเนื้อเยื่อ สุขภาพช่องปาก โรคประจำตัว ความสามารถในการหายของแผลของแต่ละบุคคล หรือพฤติกรรมการใช้งานฟัน/การบดเคี้ยว ซึ่งหากมีปัจจัยที่ควบคุมไม่ได้มาก อาจส่งผลต่อความสำเร็จของการรักษา',
];

const choose = [
  'สถานพยาบาลได้รับอนุญาตถูกต้อง ตรวจสอบได้',
  'เดินทางสะดวก หรือมีที่จอดรถสะดวกสบาย',
  'ทันตแพทย์เฉพาะทางให้บริการตามแต่ละสาขา',
  'ผลิตภัณฑ์ที่ใช้ได้มาตรฐาน มีคุณภาพ',
  'เทคโนโลยีทันตกรรมที่ทันสมัย',
  'ทันตแพทย์เฉพาะทางมีประสบการณ์',
  'การดูแลใกล้ชิดหลังการรักษาที่มีคุณภาพ',
];

const reviews = [
  { name: 'ปลาวาฬ นพรรณพ', text: 'คุณหมอแฮมให้คำปรึกษาดีมาก ให้เวลาคนไข้สุด ๆ ตรวจฟันละเอียด แนะนำการดูแลฟันให้ด้วย ประทับใจมาก' },
  { name: 'ยุทธพิชัย ไชยศรี', text: 'ตัดสินใจจากการอ่านรีวิว จนมาใช้บริการเอง ประทับใจครับ บริการดี คุณหมอมือเบา บอกก่อนทำทุกขั้นตอน' },
  { name: 'Pohnvipa K.', text: 'ประทับใจมาก ติด MRT สถานที่สะอาด ใหม่ คุณหมอใจดีมากๆ แล้วเก่งมากด้วยค่ะ' },
  { name: 'Micah Abawag', text: 'Very approachable staff. Easy to book an appointment, and a very professional dentist. ⭐️⭐️⭐️⭐️⭐️' },
];

const faq = [
  { q: 'การฝังรากฟันเทียมใช้เวลานานไหม?', a: 'ฝังรากฟันเทียม 1 ซี่ใช้เวลาไม่เกิน 30 นาที หากมีหลายซี่หรือต้องปลูกกระดูกอาจนานขึ้นเล็กน้อย' },
  { q: 'หลังฝังต้องพักฟื้นนานไหม?', a: 'เป็นการผ่าตัดเล็กภายใต้ยาชาเฉพาะที่ ส่วนใหญ่เจ็บใกล้เคียงหรือน้อยกว่าการถอนฟัน ไม่ต้องพักฟื้น ใช้ชีวิตได้ตามปกติ' },
  { q: 'ต้องปลูกกระดูกก่อนทำไหม?', a: 'ขึ้นอยู่กับความหนาของกระดูกขากรรไกร ถ้ากระดูกบางมากอาจต้องปลูกก่อน หมอจะประเมินและแนะนำวิธีที่เหมาะสมที่สุด' },
  { q: 'เป็นเบาหวานทำรากฟันเทียมได้ไหม?', a: 'ทำได้ หากควบคุมค่าน้ำตาลได้ในเกณฑ์ปกติจะไม่มีผล หากค่าน้ำตาลสูงแผลอาจหายช้ากว่าปกติเล็กน้อย' },
  { q: 'รากฟันเทียมใช้งานได้นานไหม?', a: 'แข็งแรงทนทานมาก หากดูแลความสะอาดดีและตรวจฟันสม่ำเสมอ สามารถอยู่ได้ยาวนานหรือตลอดอายุการใช้งาน' },
  { q: 'ราคา 29,900฿ รวมอะไรบ้าง?', a: 'รวมตัวรากฟันเทียม Blue Diamond + ครอบฟัน + ตรวจและวางแผน พร้อมรับประกันตัวรากฟันตลอดอายุการใช้งาน (จากราคาปกติ 50,000฿)' },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Landing title={title} description={description} jsonLd={faqLd}>
  <!-- HERO -->
  <section data-hero class="relative overflow-hidden text-white">
    <!-- cover/feature image (LCP) -->
    <img src="/images/lp/clinic1.webp" alt="ทันตแพทย์ถือรากฟันเทียม Blue Diamond ที่ SmileScape" width="1024" height="603" fetchpriority="high" class="absolute inset-0 w-full h-full object-cover object-center" />
    <div class="absolute inset-0 bg-gradient-to-r from-brand-anchor via-brand-anchor/90 to-brand-anchor/50" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-brand-anchor/85 to-transparent" aria-hidden="true"></div>
    <div class="absolute -right-16 -top-10 w-80 h-80 rounded-full bg-brand-highlight/20 blur-2xl" aria-hidden="true"></div>
    <div class="max-w-5xl mx-auto px-4 py-12 md:py-16 grid md:grid-cols-2 gap-10 items-center relative">
      <div>
        <p class="font-display text-xs font-semibold uppercase tracking-[0.18em] text-brand-highlight">
          Blue Diamond Implant · นำเข้าเกาหลี
        </p>
        <h1 class="mt-3 text-3xl md:text-5xl font-bold leading-tight">
          รากฟันเทียม<br />เริ่ม <span class="price-hl">29,900฿</span><br />รวมครอบฟัน
        </h1>
        <p class="mt-4 text-white/85 text-lg">
          รับประกันตลอดอายุการใช้งาน · ผ่อน 0% ไม่ต้องใช้บัตร · ดูแลโดยทันตแพทย์เฉพาะทางศัลยฯ มหิดล
        </p>
        <div class="mt-4 flex flex-wrap gap-2 text-sm">
          <span class="rounded-full bg-white/10 border border-white/15 px-3 py-1">✓ 2 สาขา ติด MRT</span>
          <span class="rounded-full bg-white/10 border border-white/15 px-3 py-1">✓ ฟรี ปรึกษา + วางแผน</span>
          <span class="rounded-full bg-white/10 border border-white/15 px-3 py-1">✓ รีวิวจริง 5 ดาว</span>
        </div>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href={LINE_URL} class="cta-pulse rounded-full bg-brand-primary-deep px-6 py-3 font-semibold hover:opacity-90">
            จองคิวปรึกษาฟรี (LINE) →
          </a>
          <a href={`tel:${PHONE_TEL}`} class="rounded-full border border-white/35 px-6 py-3 font-semibold hover:bg-white/10">
            ☎ โทร 092 293 6226
          </a>
        </div>
      </div>

      <!-- Offer card -->
      <div class="bg-white text-brand-neutral-900 rounded-2xl p-6 shadow-lg">
        <div class="flex items-center gap-2">
          <span class="rounded-full bg-brand-accent/15 text-brand-primary-deep text-xs font-semibold px-3 py-1">โปรโมชั่นพิเศษ</span>
          <span class="text-sm text-brand-neutral-500 line-through">ปกติ 50,000฿</span>
        </div>
        <div class="mt-2 font-display font-extrabold text-5xl text-brand-anchor">29,900฿
          <span class="text-base font-sans font-medium text-brand-neutral-500">/ ซี่</span>
        </div>
        <div class="mt-2 inline-flex items-center gap-1.5 rounded-full bg-brand-accent/20 px-3 py-1.5 text-[15px] font-bold text-brand-primary-deep">
          ✓ ราคานี้รวมครอบฟันแล้ว
        </div>
        <ul class="mt-4 space-y-2 text-[15px]">
          {included.map((i) => (
            <li class="flex gap-2"><span class="text-brand-primary-deep font-bold">✓</span><span>{i}</span></li>
          ))}
        </ul>
        <a href={LINE_URL} class="mt-5 block text-center rounded-full bg-brand-primary-deep px-6 py-3 font-semibold text-white hover:opacity-90">
          รับโปรฯ จำนวนจำกัด — แอด LINE
        </a>
      </div>
    </div>
  </section>

  <!-- TRUST BAR -->
  <section class="bg-brand-ice border-y border-brand-neutral-200">
    <div class="max-w-5xl mx-auto px-4 py-4 grid grid-cols-2 md:grid-cols-4 gap-3 text-center text-sm font-medium text-brand-anchor">
      <div>🦷 เฉพาะทางศัลยฯ มหิดล</div>
      <div>🚆 ติดรถไฟฟ้า 2 สาขา</div>
      <div>♾️ รับประกันตลอดชีพ</div>
      <div>💳 ผ่อน 0% ไม่ใช้บัตร</div>
    </div>
  </section>

  <!-- BEFORE / AFTER GALLERY (social proof up top) -->
  <section class="max-w-5xl mx-auto px-4 py-14">
    <div class="text-center">
      <p class="font-display text-xs font-semibold uppercase tracking-[0.18em] text-brand-primary-deep">Real Results</p>
      <h2 class="mt-2 text-2xl md:text-3xl font-bold text-brand-anchor">ผลลัพธ์จริง ก่อน &amp; หลัง</h2>
      <p class="mt-2 text-brand-neutral-500">เคสจริงจากคนไข้ที่ SmileScape Clinic</p>
    </div>
    <div class="mt-8 grid grid-cols-2 md:grid-cols-4 gap-3">
      {beforeAfter.map((src, i) => (
        <figure class={`relative rounded-xl overflow-hidden border border-brand-neutral-200 bg-white ${i === 0 ? 'col-span-2 md:col-span-1' : ''}`}>
