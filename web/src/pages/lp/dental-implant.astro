          background-repeat:no-repeat; background-position:right 13px center; padding-right:38px;
        }
        #smilescape-lead-form .ssf-field input:focus,
        #smilescape-lead-form .ssf-field select:focus{
          border-color:var(--ss-cyan); background:#fff;
          box-shadow:0 0 0 4px rgba(33,125,234,.13);
        }
        #smilescape-lead-form .ssf-field input::placeholder{color:var(--ss-text3)}
        #smilescape-lead-form .ssf-field.ssf-invalid input,
        #smilescape-lead-form .ssf-field.ssf-invalid select{
          border-color:var(--ss-red); background:#fff5f5;
        }
        #smilescape-lead-form .ssf-err{
          display:none; font-size:12.5px; color:var(--ss-red); margin-top:5px;
        }
        #smilescape-lead-form .ssf-field.ssf-invalid .ssf-err{display:block}
        #smilescape-lead-form .ssf-hint{font-size:12px; color:var(--ss-text3); margin-top:5px}
        #smilescape-lead-form .ssf-consent{
          display:flex; gap:10px; align-items:flex-start; margin-top:18px;
          background:var(--ss-bg2); border:1px solid var(--ss-border); border-radius:11px; padding:13px 14px;
        }
        #smilescape-lead-form .ssf-consent input{margin-top:3px; width:18px; height:18px; accent-color:var(--ss-blue); flex:0 0 auto}
        #smilescape-lead-form .ssf-consent label{font-size:12.5px; color:var(--ss-text2); line-height:1.55}
        #smilescape-lead-form .ssf-consent a{color:var(--ss-blue); font-weight:600; text-decoration:underline}
        #smilescape-lead-form .ssf-consent.ssf-invalid{border-color:var(--ss-red); background:#fff5f5}
        #smilescape-lead-form .ssf-submit{
          width:100%; margin-top:18px; font:inherit; font-size:16.5px; font-weight:700; color:#fff;
          background:linear-gradient(135deg,var(--ss-cyan),var(--ss-blue)); border:none; border-radius:12px;
          padding:15px 18px; cursor:pointer; transition:filter .15s, transform .05s, box-shadow .15s;
          box-shadow:0 12px 26px -12px rgba(17,83,161,.65); display:flex; align-items:center; justify-content:center; gap:10px;
        }
        #smilescape-lead-form .ssf-submit:hover{filter:brightness(1.06)}
        #smilescape-lead-form .ssf-submit:active{transform:translateY(1px)}
        #smilescape-lead-form .ssf-submit:disabled{opacity:.7; cursor:not-allowed; filter:none}
        #smilescape-lead-form .ssf-spin{
          width:17px; height:17px; border:2.5px solid rgba(255,255,255,.45); border-top-color:#fff;
          border-radius:50%; animation:ssf-rot .7s linear infinite; display:none;
        }
        #smilescape-lead-form.ssf-sending .ssf-spin{display:inline-block}
        @keyframes ssf-rot{to{transform:rotate(360deg)}}
        #smilescape-lead-form .ssf-secure{
          text-align:center; font-size:11.5px; color:var(--ss-text3); margin-top:13px;
          display:flex; align-items:center; justify-content:center; gap:5px;
        }
        #smilescape-lead-form .ssf-hp{position:absolute; left:-9999px; width:1px; height:1px; overflow:hidden}
        #smilescape-lead-form .ssf-result{display:none; padding:34px 26px; text-align:center}
        #smilescape-lead-form .ssf-result .ssf-ico{
          width:64px; height:64px; border-radius:50%; margin:0 auto 16px; display:flex; align-items:center; justify-content:center;
        }
        #smilescape-lead-form .ssf-result.ok .ssf-ico{background:#e3f5ef; color:var(--ss-green)}
        #smilescape-lead-form .ssf-result.fail .ssf-ico{background:#fde8e8; color:var(--ss-red)}
        #smilescape-lead-form .ssf-result h3{font-size:21px; font-weight:700; margin-bottom:8px}
        #smilescape-lead-form .ssf-result p{font-size:14.5px; color:var(--ss-text2); margin-bottom:6px}
        #smilescape-lead-form .ssf-fallback{
          margin-top:16px; display:flex; flex-direction:column; gap:9px; align-items:center;
        }
        #smilescape-lead-form .ssf-fallback a{
          display:inline-flex; align-items:center; gap:8px; font-size:14.5px; font-weight:600; text-decoration:none;
          padding:10px 18px; border-radius:10px; border:1.5px solid var(--ss-border); color:var(--ss-blue); background:var(--ss-bg);
        }
        #smilescape-lead-form .ssf-retry{
          margin-top:14px; font:inherit; font-size:14.5px; font-weight:600; color:var(--ss-blue);
          background:none; border:none; cursor:pointer; text-decoration:underline;
        }
        #smilescape-lead-form.ssf-done .ssf-formwrap{display:none}
        </style>

        <div id="smilescape-lead-form">
          <div class="ssf-card">
            <div class="ssf-head">
              <div class="ssf-eyebrow">SmileScape Dental Clinic</div>
              <h2>นัดหมาย &amp; ปรึกษาทันตแพทย์ฟรี</h2>
              <p>กรอกข้อมูลสั้น ๆ ทีมงานจะติดต่อกลับเพื่อยืนยันวันและเวลานัดหมายของคุณ</p>
            </div>
            <div class="ssf-formwrap">
              <form class="ssf-body" id="ssfForm" novalidate>
                <div class="ssf-field ssf-full" data-field>
                  <label class="ssf-lab" for="ssf-service">บริการที่สนใจ<span class="ssf-req">*</span></label>
                  <select id="ssf-service" name="service" required>
                    <option value="" disabled selected>— เลือกบริการ —</option>
                    <option>รากฟันเทียม (Dental Implant)</option>
                    <option>รากฟันเทียมทั้งปาก All-on-4 / All-on-X</option>
                    <option>จัดฟัน / จัดฟันใส (Clear Aligner)</option>
                    <option>ครอบฟัน / สะพานฟัน / ฟันปลอม</option>
                    <option>วีเนียร์ / ออกแบบรอยยิ้ม (Veneer &amp; Smile Design)</option>
                    <option>ฟอกสีฟัน (Teeth Whitening)</option>
                    <option>อุดฟัน / ถอนฟัน / ขูดหินปูน (ทันตกรรมทั่วไป)</option>
                    <option>รักษารากฟัน (Root Canal)</option>
                    <option>รักษาเหงือก / โรคปริทันต์</option>
                    <option>ทันตกรรมสำหรับเด็ก</option>
                    <option>ตรวจสุขภาพช่องปาก / ปรึกษาฟรี</option>
                    <option>บริการอื่น ๆ</option>
                  </select>
                  <div class="ssf-err">กรุณาเลือกบริการที่สนใจ</div>
                </div>
                <div class="ssf-grid">
                  <div class="ssf-field" data-field>
                    <label class="ssf-lab" for="ssf-firstName">ชื่อ<span class="ssf-req">*</span></label>
                    <input id="ssf-firstName" name="firstName" type="text" autocomplete="given-name" placeholder="ชื่อจริง" required>
                    <div class="ssf-err">กรุณากรอกชื่อ</div>
                  </div>
                  <div class="ssf-field" data-field>
                    <label class="ssf-lab" for="ssf-lastName">นามสกุล<span class="ssf-req">*</span></label>
                    <input id="ssf-lastName" name="lastName" type="text" autocomplete="family-name" placeholder="นามสกุล" required>
                    <div class="ssf-err">กรุณากรอกนามสกุล</div>
                  </div>
                  <div class="ssf-field" data-field>
                    <label class="ssf-lab" for="ssf-phone">เบอร์โทรศัพท์<span class="ssf-req">*</span></label>
                    <input id="ssf-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="08X-XXX-XXXX" required>
                    <div class="ssf-err">กรุณากรอกเบอร์โทรให้ถูกต้อง</div>
                  </div>
                  <div class="ssf-field" data-field>
                    <label class="ssf-lab" for="ssf-email">อีเมล <span class="ssf-hint" style="display:inline">(ไม่บังคับ)</span></label>
                    <input id="ssf-email" name="email" type="email" autocomplete="email" placeholder="you@email.com">
                    <div class="ssf-err">รูปแบบอีเมลไม่ถูกต้อง</div>
                  </div>
                  <div class="ssf-field" data-field>
                    <label class="ssf-lab" for="ssf-date">วันที่สะดวกนัดหมาย<span class="ssf-req">*</span></label>
                    <input id="ssf-date" name="appointmentDate" type="date" required>
                    <div class="ssf-err">กรุณาเลือกวันที่</div>
                  </div>
                  <div class="ssf-field" data-field>
                    <label class="ssf-lab" for="ssf-time">เวลาที่สะดวก<span class="ssf-req">*</span></label>
                    <select id="ssf-time" name="appointmentTime" required>
                      <option value="" disabled selected>— เลือกเวลา —</option>
                    </select>
                    <div class="ssf-err">กรุณาเลือกเวลา</div>
                  </div>
                </div>
                <div class="ssf-field ssf-full" data-field style="margin-top:14px">
                  <label class="ssf-lab" for="ssf-branch">สาขาที่ต้องการ<span class="ssf-req">*</span></label>
                  <select id="ssf-branch" name="branch" required>
                    <option value="" disabled selected>— เลือกสาขา —</option>
                    <option>สาขารัตนาธิเบศร์ (นนทบุรี · MRT สีม่วง รัตนาธิเบศร์)</option>
                    <option>สาขาศรีนครินทร์ (กรุงเทพฯ · MRT สีเหลือง)</option>
                    <option>ยังไม่แน่ใจ — ให้ทีมงานแนะนำ</option>
                  </select>
                  <div class="ssf-err">กรุณาเลือกสาขา</div>
                </div>
                <div class="ssf-hp" aria-hidden="true">
                  <label>อย่ากรอกช่องนี้</label>
                  <input type="text" name="company" tabindex="-1" autocomplete="off">
                </div>
                <div class="ssf-consent" data-consent>
                  <input id="ssf-consent" type="checkbox" required>
                  <label for="ssf-consent">
                    ข้าพเจ้ายินยอมให้ SmileScape Dental Clinic จัดเก็บและใช้ข้อมูลข้างต้นเพื่อติดต่อกลับและนัดหมาย
                    ตาม<a href="/privacy-policy/" target="_blank" rel="noopener">นโยบายความเป็นส่วนตัว (PDPA)</a>
                  </label>
                </div>
                <button type="submit" class="ssf-submit" id="ssfSubmit">
                  <span class="ssf-spin" aria-hidden="true"></span>
                  <span class="ssf-btn-label">ยืนยันการนัดหมาย</span>
                </button>
                <div class="ssf-secure">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                  ข้อมูลของคุณถูกส่งอย่างปลอดภัย และใช้เพื่อการนัดหมายเท่านั้น
                </div>
              </form>
            </div>
            <div class="ssf-result ok" id="ssfOk">
              <div class="ssf-ico">
                <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </div>
              <h3>ได้รับข้อมูลของคุณแล้ว 🎉</h3>
              <p>ทีมงาน SmileScape จะติดต่อกลับเพื่อยืนยันการนัดหมายโดยเร็วที่สุด</p>
              <p style="font-size:13px;color:var(--ss-text3)">โดยปกติภายในเวลาทำการ (10:00–20:00 น.)</p>
              <div class="ssf-fallback" id="ssfOkFallback"></div>
            </div>
            <div class="ssf-result fail" id="ssfFail">
              <div class="ssf-ico">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
              </div>
              <h3>ส่งข้อมูลไม่สำเร็จ</h3>
              <p>ขออภัย เกิดข้อผิดพลาดในการส่ง กรุณาลองอีกครั้ง หรือติดต่อเราโดยตรง</p>
              <div class="ssf-fallback" id="ssfFailFallback"></div>
              <button type="button" class="ssf-retry" id="ssfRetry">↻ ลองส่งอีกครั้ง</button>
            </div>
          </div>
        </div>

        <script is:inline>
        (function(){
          var CONFIG = {
            webhookUrl: 'https://nexorcus.app.n8n.cloud/webhook/smilescape-website-lead-form',
            clinicPhone: '092 293 6226',
            lineUrl: 'https://maac.io/6yp2p',
            timeStart: 10, timeEnd: 20, slotMinutes: 30
          };
          var root = document.getElementById('smilescape-lead-form');
          var form = document.getElementById('ssfForm');
          if(!root || !form) return;
          var submitBtn = document.getElementById('ssfSubmit');
          var btnLabel  = root.querySelector('.ssf-btn-label');
          var okPanel   = document.getElementById('ssfOk');
          var failPanel = document.getElementById('ssfFail');
          var dateInput = document.getElementById('ssf-date');
          var timeSel   = document.getElementById('ssf-time');
          (function(){
            for(var h=CONFIG.timeStart; h<CONFIG.timeEnd; h++){
              for(var m=0; m<60; m+=CONFIG.slotMinutes){
                var t = (h<10?'0':'')+h+':'+(m<10?'0':'')+m;
                var o = document.createElement('option');
                o.value = t; o.textContent = t + ' น.';
                timeSel.appendChild(o);
              }
            }
          })();
          (function(){
            var d = new Date();
            var iso = d.getFullYear()+'-'+('0'+(d.getMonth()+1)).slice(-2)+'-'+('0'+d.getDate()).slice(-2);
            dateInput.min = iso;
          })();
          function buildFallback(el){
            if(!el) return;
            var html = '';
            if(CONFIG.clinicPhone){
              html += '<a href="tel:'+CONFIG.clinicPhone.replace(/[^0-9+]/g,'')+'">'
                    + '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>'
                    + 'โทร '+CONFIG.clinicPhone+'</a>';
            }
            if(CONFIG.lineUrl){
              html += '<a href="'+CONFIG.lineUrl+'" target="_blank" rel="noopener" style="color:#06C755;border-color:#b6ecca;background:#f1fcf5">'
                    + '<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 5.64 2 10.13c0 4.02 3.55 7.39 8.35 8.02.33.07.77.22.88.5.1.26.07.66.03.92l-.14.85c-.04.26-.2 1.02.89.56s5.86-3.45 8-5.9c1.48-1.63 2.19-3.28 2.19-5.95C22.2 5.64 17.72 2 12 2z"/></svg>'
                    + 'แชทผ่าน LINE</a>';
            }
            el.innerHTML = html;
          }
          buildFallback(document.getElementById('ssfOkFallback'));
          buildFallback(document.getElementById('ssfFailFallback'));
          function fieldOf(input){ return input.closest('[data-field]'); }
          function setInvalid(input, bad){ var f = fieldOf(input); if(f) f.classList.toggle('ssf-invalid', !!bad); }
          function validEmail(v){ return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v); }
          function validPhone(v){ var d = v.replace(/[\s\-().]/g,''); return /^(0\d{8,9}|\+?66\d{8,9})$/.test(d); }
          form.addEventListener('input', function(e){
            var f = fieldOf(e.target); if(f) f.classList.remove('ssf-invalid');
            var c = e.target.closest('[data-consent]'); if(c) c.classList.remove('ssf-invalid');
          });
          function validate(){
            var ok = true, firstBad = null;
            var req = [
              ['ssf-service','val'], ['ssf-firstName','val'], ['ssf-lastName','val'],
              ['ssf-phone','phone'], ['ssf-date','val'], ['ssf-time','val'], ['ssf-branch','val']
            ];
            req.forEach(function(r){
              var el = document.getElementById(r[0]); var bad=false;
              var v = (el.value||'').trim();
              if(r[1]==='val') bad = !v;
              else if(r[1]==='phone') bad = !validPhone(v);
              setInvalid(el, bad);
              if(bad){ ok=false; if(!firstBad) firstBad=el; }
            });
            var em = document.getElementById('ssf-email'); var ev=(em.value||'').trim();
            if(ev && !validEmail(ev)){ setInvalid(em,true); ok=false; if(!firstBad) firstBad=em; }
            var cons = document.getElementById('ssf-consent');
            if(!cons.checked){ cons.closest('[data-consent]').classList.add('ssf-invalid'); ok=false; if(!firstBad) firstBad=cons; }
            if(firstBad){ try{ firstBad.focus({preventScroll:false}); }catch(_){ firstBad.focus(); } }
            return ok;
          }
          function toDDMMYYYY(iso){ if(!iso) return ''; var p = iso.split('-'); return p.length===3 ? (p[2]+'/'+p[1]+'/'+p[0]) : iso; }
          function genId(){ return 'ss-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2,8); }
          function setSending(on){
            root.classList.toggle('ssf-sending', on);
            submitBtn.disabled = on;
            btnLabel.textContent = on ? 'กำลังส่ง…' : 'ยืนยันการนัดหมาย';
          }
          function showResult(which){
            root.classList.add('ssf-done');
            okPanel.style.display   = which==='ok'   ? 'block' : 'none';
            failPanel.style.display = which==='fail' ? 'block' : 'none';
            try{ root.scrollIntoView({behavior:'smooth', block:'start'}); }catch(_){}
          }
          var lastPayload = null;
          function buildPayload(){
            var hp = form.querySelector('input[name="company"]');
            if(hp && hp.value){ return {__spam:true}; }
            return {
              service:         document.getElementById('ssf-service').value,
              firstName:       document.getElementById('ssf-firstName').value.trim(),
              lastName:        document.getElementById('ssf-lastName').value.trim(),
              phone:           document.getElementById('ssf-phone').value.trim(),
              email:           document.getElementById('ssf-email').value.trim(),
              appointmentDate: toDDMMYYYY(document.getElementById('ssf-date').value),
              appointmentTime: document.getElementById('ssf-time').value,
              branch:          document.getElementById('ssf-branch').value,
              submissionId:    genId(),
              consent:         true,
              pageUrl:         (location && location.href) || '',
              submittedAt:     new Date().toISOString()
            };
          }
          function send(payload){
            setSending(true);
            if(payload && payload.__spam){
              setTimeout(function(){ setSending(false); showResult('ok'); }, 600);
              return;
            }
            fetch(CONFIG.webhookUrl, {
              method:'POST',
              headers:{'Content-Type':'application/json'},
              body: JSON.stringify(payload)
            }).then(function(res){
              if(!res.ok) throw new Error('HTTP '+res.status);
              (window.dataLayer = window.dataLayer || []).push({ event:'lead_submit', form_service: payload.service, form_branch: payload.branch });
              setSending(false); showResult('ok'); form.reset();
            }).catch(function(err){
              setSending(false); showResult('fail');
              try{ console.warn('[SmileScape form] submit failed:', err); }catch(_){}
            });
          }
          form.addEventListener('submit', function(e){
            e.preventDefault();
            if(!validate()) return;
            lastPayload = buildPayload();
            send(lastPayload);
          });
          document.getElementById('ssfRetry').addEventListener('click', function(){
            failPanel.style.display='none';
            if(lastPayload && !lastPayload.__spam){
              lastPayload.submissionId = genId();
              lastPayload.submittedAt = new Date().toISOString();
              root.classList.remove('ssf-done');
              send(lastPayload);
            } else {
              root.classList.remove('ssf-done');
            }
          });
        })();
        </script>
      </div>

      <!-- doctor + trust badges -->
      <div class="relative mt-6 md:mt-0 -mx-4 md:mx-0">
        <img src="/images/lp/doctor-haam-cutout.png" alt="ทพ. วรภัทร จรางกุล (หมอแฮม)" width="996" height="1094" loading="lazy" class="block w-full max-w-none md:max-w-[460px] mx-auto" />
        <div class="absolute bottom-10 right-0 lg:-right-2 bg-white rounded-2xl shadow-xl p-5 space-y-3 max-w-[280px]">
          <div class="flex items-center gap-3">
            <span class="flex-none w-6 h-6 rounded-full bg-brand-accent text-white grid place-items-center text-sm font-bold">✓</span>
            <span class="font-medium text-brand-anchor">ทันตแพทย์เฉพาะทาง</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="flex-none w-6 h-6 rounded-full bg-brand-accent text-white grid place-items-center text-sm font-bold">✓</span>
            <span class="font-medium text-brand-anchor">เดินทางสะดวก ติดรถไฟฟ้า</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="bg-brand-anchor text-white">
    <div class="max-w-5xl mx-auto px-4 py-14 text-center">
      <h2 class="font-display text-2xl md:text-3xl font-bold">พร้อมเริ่มต้นรอยยิ้มใหม่?</h2>
      <p class="mt-2 text-white/85">ปรึกษาฟรีกับทันตแพทย์เฉพาะทาง · เลือกสาขาที่สะดวก · รับโปรฯ 29,900฿ จำนวนจำกัด</p>
      <div class="mt-6 flex flex-wrap gap-3 justify-center">
        <a href={LINE_URL} class="rounded-full bg-brand-primary-deep px-7 py-3 font-semibold hover:opacity-90">จองคิวผ่าน LINE →</a>
        <a href={`tel:${PHONE_TEL}`} class="rounded-full border border-white/35 px-7 py-3 font-semibold hover:bg-white/10">☎ โทร 092 293 6226</a>
      </div>
    </div>
  </section>

  <!-- Lightbox for before/after gallery -->
  <div id="ba-lightbox" class="ba-lightbox" aria-hidden="true" role="dialog" aria-modal="true" aria-label="ภาพผลลัพธ์ขนาดเต็ม">
    <button type="button" class="ba-close" aria-label="ปิด">✕</button>
    <img class="ba-lightbox-img" src="" alt="" />
  </div>
</Landing>

<style>
  /* Blue Diamond gentle float (premium motion). Respects reduced-motion. */
  @keyframes bd-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-14px); }
  }
  .bd-float {
    animation: bd-float 4s ease-in-out infinite;
    will-change: transform;
  }
  @media (prefers-reduced-motion: reduce) {
    .bd-float { animation: none; }
  }

  /* Component callouts — pulsing dots + staggered animated labels */
  .cmp-marker { position: absolute; transform: translate(-50%, -50%); }
  .cmp-dot {
    display: block; width: 14px; height: 14px; border-radius: 9999px;
    background: #217DEA; box-shadow: 0 0 0 4px rgba(33, 125, 234, 0.25);
    animation: cmp-pulse 2s ease-in-out infinite;
  }
  @keyframes cmp-pulse {
    0%, 100% { box-shadow: 0 0 0 4px rgba(33, 125, 234, 0.25); }
    50% { box-shadow: 0 0 0 9px rgba(33, 125, 234, 0); }
  }
  .cmp-label {
    position: absolute; white-space: nowrap;
    background: #fff; border: 1px solid #e2e8f0; border-radius: 9999px;
    padding: 4px 11px; font-size: 12px; font-weight: 600; line-height: 1.15; color: #14386b;
    box-shadow: 0 6px 14px rgba(20, 56, 107, 0.12);
  }
  .cmp-label small { display: block; font-weight: 400; font-size: 10px; color: #64748b; }
  .cmp-label--left  { right: 22px; top: 50%; transform: translateY(-50%); }
  .cmp-label--right { left: 22px; top: 50%; transform: translateY(-50%); }
  .cmp-label--top   { left: 50%; bottom: 22px; transform: translateX(-50%); }
  /* progressive entrance: JS adds .cmp-js (hide), then .shown (reveal staggered) */
  .cmp-fig.cmp-js .cmp-label { opacity: 0; }
  .cmp-fig.cmp-js .cmp-label--left  { transform: translateY(-50%) translateX(10px); }
  .cmp-fig.cmp-js .cmp-label--right { transform: translateY(-50%) translateX(-10px); }
  .cmp-fig.cmp-js .cmp-label--top   { transform: translateX(-50%) translateY(10px); }
  .cmp-fig.cmp-js.shown .cmp-label {
    opacity: 1; transition: opacity 0.5s ease, transform 0.5s ease;
    transition-delay: calc(var(--i) * 0.2s + 0.15s);
  }
  .cmp-fig.cmp-js.shown .cmp-label--left,
  .cmp-fig.cmp-js.shown .cmp-label--right { transform: translateY(-50%); }
  .cmp-fig.cmp-js.shown .cmp-label--top { transform: translateX(-50%); }
  @media (prefers-reduced-motion: reduce) {
    .cmp-dot { animation: none; }
    .cmp-fig.cmp-js .cmp-label { opacity: 1 !important; transition: none; }
    .cmp-fig.cmp-js .cmp-label--left, .cmp-fig.cmp-js .cmp-label--right { transform: translateY(-50%); }
    .cmp-fig.cmp-js .cmp-label--top { transform: translateX(-50%); }
  }

  /* Hero price highlighter — white number with a coral marker stripe (pops on navy) */
  .price-hl {
    color: #fff;
    background: linear-gradient(transparent 56%, rgba(238, 156, 156, 0.65) 56%);
    padding: 0 0.12em;
    border-radius: 3px;
    white-space: nowrap;
  }

  /* CTA attention pulse — radiating ring on the LINE button */
  @keyframes cta-pulse {
    0%   { box-shadow: 0 0 0 0 rgba(127, 180, 255, 0.55); }
    70%  { box-shadow: 0 0 0 14px rgba(127, 180, 255, 0); }
    100% { box-shadow: 0 0 0 0 rgba(127, 180, 255, 0); }
  }
  .cta-pulse { animation: cta-pulse 2s ease-out infinite; }
  @media (prefers-reduced-motion: reduce) {
    .cta-pulse { animation: none; }
  }

  /* Before/after lightbox */
  .ba-lightbox {
    position: fixed; inset: 0; z-index: 100;
    display: none; align-items: center; justify-content: center;
    background: rgba(11, 26, 46, 0.93); padding: 20px;
  }
  .ba-lightbox.open { display: flex; }
  .ba-lightbox-img {
    max-width: 100%; max-height: 88vh; width: auto; height: auto;
    border-radius: 12px; box-shadow: 0 16px 50px rgba(0, 0, 0, 0.55);
    animation: ba-zoom 0.22s ease;
  }
  @keyframes ba-zoom { from { transform: scale(0.94); opacity: 0; } to { transform: scale(1); opacity: 1; } }
  .ba-close {
    position: absolute; top: 14px; right: 14px;
    width: 44px; height: 44px; border-radius: 9999px;
    background: rgba(255, 255, 255, 0.16); color: #fff; font-size: 20px;
    border: none; cursor: pointer; line-height: 1;
  }
  .ba-close:hover { background: rgba(255, 255, 255, 0.28); }

  /* Doctor cross-fade (dissolve) — แฮม ↔ แพรว, image + name in sync (8s loop) */
  @keyframes doc-cross-a {
    0%, 42% { opacity: 1; }
    50%, 92% { opacity: 0; }
    100% { opacity: 1; }
  }
  @keyframes doc-cross-b {
    0%, 42% { opacity: 0; }
    50%, 92% { opacity: 1; }
    100% { opacity: 0; }
  }
  .doc-img-a, .doc-name-a { animation: doc-cross-a 8s ease-in-out infinite; }
  .doc-img-b, .doc-name-b { animation: doc-cross-b 8s ease-in-out infinite; }
  @media (prefers-reduced-motion: reduce) {
    .doc-img-a, .doc-name-a { animation: none; opacity: 1; }
    .doc-img-b, .doc-name-b { animation: none; opacity: 0; }
  }
</style>

<script>
  for (const fig of document.querySelectorAll('.cmp-fig')) {
    fig.classList.add('cmp-js');
    new IntersectionObserver((entries, obs) => {
      for (const e of entries) {
        if (e.isIntersecting) { e.target.classList.add('shown'); obs.unobserve(e.target); }
      }
    }, { threshold: 0.35 }).observe(fig);
  }

  // Before/after lightbox
  const lb = document.getElementById('ba-lightbox');
  if (lb) {
    const lbImg = lb.querySelector('.ba-lightbox-img');
    const open = (src, alt) => {
      lbImg.src = src; lbImg.alt = alt || '';
      lb.classList.add('open'); lb.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    };
    const close = () => {
      lb.classList.remove('open'); lb.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = ''; lbImg.src = '';
    };
    for (const img of document.querySelectorAll('.ba-img')) {
      img.addEventListener('click', () => open(img.currentSrc || img.src, img.alt));
    }
    lb.addEventListener('click', (e) => {
      if (e.target === lb || e.target.classList.contains('ba-close')) close();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && lb.classList.contains('open')) close();
    });
  }
</script>
