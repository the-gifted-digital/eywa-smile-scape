---
import Base from '~/layouts/Base.astro';

const title = 'SmileScape Dental Clinic';
const description =
  'SmileScape Dental Clinic — a lifetime foundation for your smile. Implant-first dental care, led by specialist dentists. Branches at Rattanathibet and Srinakarin.';
---

<Base title={title} description={description}>
  <section class="bg-brand-anchor text-brand-neutral-0">
    <div class="max-w-6xl mx-auto px-4 py-20 md:py-28">
      <p class="font-display text-sm font-medium uppercase tracking-[0.2em] text-brand-highlight">
        The Lifetime Foundation
      </p>
      <h1 class="font-display mt-4 text-4xl md:text-6xl font-bold leading-tight">
        A stable foundation for a lifetime of smiles
      </h1>
      <p class="mt-6 max-w-xl text-lg text-brand-neutral-200">
        A specialist implant-first dental clinic, led by experienced dentists with
        a focus on careful diagnosis and long-term care.
      </p>
      <div class="mt-8">
        <a
          href="/en/booking/"
          class="rounded-full bg-brand-primary px-6 py-3 font-semibold text-brand-neutral-0 hover:bg-brand-primary-deep"
        >
          Book a consultation
        </a>
      </div>
    </div>
  </section>
</Base>
