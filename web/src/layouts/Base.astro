---
// Base layout — shared HTML shell for standard SmileScape pages.
//
// Mirrors the EYWA Astro reference shell (DR-EYWA-MKT-005) with:
//   - i18n-aware <html lang> + hreflang alternates (th default / en)
//   - SEO + OpenGraph
//   - Dentist / MedicalClinic JSON-LD (NAP = PLACEHOLDERS until operator confirms)
//   - Partytown-gated analytics (no-op until PUBLIC_GTM_ID is set)
// Brand fonts (locked 2026-06-07) — self-hosted, no Google Fonts CDN.
//   Body / UI (Latin + Thai): Google Sans     — public/fonts (src/styles/fonts.css) → font-sans
//   Display (headings):       Cabinet Grotesk — public/fonts (src/styles/fonts.css) → font-display
import '~/styles/fonts.css';
import '~/styles/global.css';
import AnalyticsHead from '~/components/AnalyticsHead.astro';
import AnalyticsBody from '~/components/AnalyticsBody.astro';
import StickyCta from '~/components/sections/StickyCta.astro';
const PHONE_TEL = '+66922936226';
const PHONE_DISPLAY = '092 293 6226';
const LINE_URL = 'https://maac.io/6yp2p';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  /** override for non-website OG types, e.g. 'article' */
  ogType?: string;
  /** extra JSON-LD node(s) to merge into the page (e.g. Service, FAQPage) */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  robots?: string;        // NEW — go. policy default
  stickyCta?: boolean;    // NEW
}

const { title, description, canonical, ogType = 'website', jsonLd, robots = 'noindex,follow', stickyCta = false } = Astro.props;

const siteName = 'SmileScape Dental Clinic';
const lang = (Astro.currentLocale ?? 'th') as 'th' | 'en' | 'zh-cn';
const ogLocale = lang === 'en' ? 'en_US' : lang === 'zh-cn' ? 'zh_CN' : 'th_TH';

const fullTitle = title === siteName ? title : `${title} | ${siteName}`;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).toString();

// hreflang alternates (TH-first; prefixDefaultLocale:false → th at root, en under /en/, zh-cn under /zh-cn/).
const p = Astro.url.pathname;
const seg = p.split('/')[1];
const known = ['en', 'zh-cn'];
const basePath = known.includes(seg) ? (p.slice(seg.length + 1) || '/') : p;
const withLocale = (loc: string) => (loc === 'th' ? basePath : ('/' + loc + basePath).replace(/\/{2,}/g, '/'));
const alt = {
  th: new URL(withLocale('th'), Astro.site).toString(),
  en: new URL(withLocale('en'), Astro.site).toString(),
  'zh-cn': new URL(withLocale('zh-cn'), Astro.site).toString(),
};

// ---- Organization JSON-LD (PLACEHOLDER NAP — see README open questions) ----
const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Dentist',
  name: siteName,
  url: Astro.site?.toString(),
  description: lang === 'zh-cn'
    ? 'SmileScape 牙科诊所 — 终身稳固的根基。以种植牙为核心的专科牙科诊所。'
    : lang === 'en'
    ? 'SmileScape Dental Clinic — The Lifetime Foundation. Implant-first specialty dental care.'
    : 'คลินิกทันตกรรม SmileScape — รากฐานฟันที่มั่นคงเพื่อความสุขที่ยั่งยืนตลอดชีวิต. เด่นด้านรากฟันเทียม (Implant-first).',
  medicalSpecialty: 'Dentistry',
  // NOTE: telephone / address / geo / openingHours are PLACEHOLDERS — fill from operator data.
  department: [
    {
      '@type': 'Dentist',
      name: 'SmileScape สาขารัตนาธิเบศร์',
      areaServed: 'รัตนาธิเบศร์ / นนทบุรี',
    },
    {
      '@type': 'Dentist',
      name: 'SmileScape สาขาศรีนครินทร์',
      areaServed: 'ศรีนครินทร์',
    },
  ],
};

const ldNodes = [orgLd, ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [])];

const navByLocale = {
  th: [{ href: '/lp/dental-implant/', label: 'รากฟันเทียม' }, { href: '/implant-check/', label: 'เช็กรากเทียม' }, { href: '/#booking', label: 'จองคิว', cta: true }],
  en: [{ href: '/en/lp/dental-implant/', label: 'Dental Implants' }, { href: '/en/implant-check/', label: 'Readiness Check' }, { href: '/en/#booking', label: 'Book Now', cta: true }],
  'zh-cn': [{ href: '/en/lp/dental-implant/', label: '种植牙' }, { href: '/zh-cn/implant-check/', label: '种植自测' }, { href: '/zh-cn/#booking', label: '预约', cta: true }],
};
const nav = navByLocale[lang] ?? navByLocale.th;
const homeHref = lang === 'en' ? '/en/' : lang === 'zh-cn' ? '/zh-cn/' : '/';
const footerByLocale = {
  th: { tagline: 'รากฐานฟันที่มั่นคง เพื่อความสุขที่ยั่งยืนตลอดชีวิต', branches: 'สาขารัตนาธิเบศร์ (MRT สีม่วง) · สาขาศรีนครินทร์ (MRT สีเหลือง)' },
  en: { tagline: 'A stable foundation for a lifetime of confident smiles', branches: 'Rattanathibet branch (MRT Purple) · Srinagarindra branch (MRT Yellow)' },
  'zh-cn': { tagline: '稳固的牙齿根基，成就一生自信笑容', branches: 'Rattanathibet 分院（MRT 紫线）· Srinagarindra 分院（MRT 黄线）' },
};
const footer = footerByLocale[lang] ?? footerByLocale.th;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/png" href="/favicon.png" />

    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content={robots} />

    <!-- hreflang -->
    <link rel="alternate" hreflang="th" href={alt.th} />
    <link rel="alternate" hreflang="en" href={alt.en} />
    <link rel="alternate" hreflang="zh-CN" href={alt['zh-cn']} />
    <link rel="alternate" hreflang="x-default" href={alt.th} />

    <!-- OpenGraph -->
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={ogLocale} />

    <meta name="generator" content={Astro.generator} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(ldNodes)} />

    <AnalyticsHead />
  </head>
  <body class="min-h-screen flex flex-col bg-brand-neutral-0 text-brand-neutral-900">
    <AnalyticsBody />
    <header class="border-b border-brand-neutral-200">
      <div class="max-w-6xl mx-auto px-4 py-3 sm:py-4 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between sm:gap-4">
        <a href={homeHref} class="font-display font-bold text-xl tracking-tight text-brand-anchor shrink-0">
          Smile<span class="text-brand-primary">Scape</span>
        </a>
        <nav class="text-sm text-brand-neutral-700 flex flex-wrap items-center gap-x-5 gap-y-2">
          {
            nav.map((item) =>
              item.cta ? (
                <a
                  href={item.href}
                  class="rounded-full bg-brand-primary px-4 py-1.5 font-medium text-brand-neutral-0 hover:bg-brand-primary-deep"
                >
                  {item.label}
                </a>
              ) : (
                <a href={item.href} class="hover:text-brand-primary">
                  {item.label}
                </a>
              )
            )
          }
        </nav>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-brand-neutral-200 mt-16 bg-brand-paper">
      <div class="max-w-6xl mx-auto px-4 py-8 text-sm text-brand-neutral-500">
        <p class="font-semibold text-brand-anchor">SmileScape Dental Clinic</p>
        <p class="mt-1">{footer.tagline}</p>
        <p class="mt-3">{footer.branches}</p>
        <p class="mt-3">© {new Date().getFullYear()} SmileScape Dental Clinic</p>
      </div>
    </footer>
    {stickyCta && <StickyCta phoneTel={PHONE_TEL} phoneDisplay={PHONE_DISPLAY} lineUrl={LINE_URL} />}
    <script>
      // Global conversion listeners (set GTM triggers: line_click / call_click)
      document.addEventListener('click', (e) => {
        const a = (e.target as HTMLElement).closest('a');
        if (!a) return;
        const href = a.getAttribute('href') || '';
        const dl = ((window as any).dataLayer = (window as any).dataLayer || []);
        if (href.includes('maac.io') || href.includes('lin.ee') || href.includes('line.me')) dl.push({ event: 'line_click', link_url: href });
        else if (href.startsWith('tel:')) dl.push({ event: 'call_click', link_url: href });
      });
    </script>
    <script>
      // Motion layer — reveal on scroll (spring), staggered groups, desktop parallax.
      // Fully disabled under prefers-reduced-motion.
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduceMotion) {
        // staggered groups: each child gets an incremental reveal delay
        document.querySelectorAll('[data-reveal-stagger]').forEach((group) => {
          group.querySelectorAll(':scope > [data-reveal]').forEach((el, i) => {
            (el as HTMLElement).style.setProperty('--reveal-delay', (i * 0.09) + 's');
          });
        });
        // reveal on scroll
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
          });
        }, { threshold: 0.18, rootMargin: '0px 0px -8% 0px' });
        document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

        // desktop-only parallax (bounded, rAF-throttled)
        if (window.matchMedia('(min-width: 768px)').matches) {
          const items = Array.from(document.querySelectorAll('[data-parallax]')) as HTMLElement[];
          if (items.length) {
            let ticking = false;
            const update = () => {
              const y = window.scrollY;
              items.forEach((el) => {
                const f = parseFloat(el.dataset.parallax || '0.08');
                const offset = Math.min(y * f, 48);
                el.style.transform = 'translate3d(0,' + offset.toFixed(1) + 'px,0)';
              });
              ticking = false;
            };
            window.addEventListener('scroll', () => {
              if (!ticking) { ticking = true; requestAnimationFrame(update); }
            }, { passive: true });
            update();
          }
        }
      }
    </script>
  </body>
</html>
