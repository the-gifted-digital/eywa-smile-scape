---
// DecorLayer.astro — seasonal/festival decorative overlay, date-gated + client-side.
// Design: docs/superpowers/specs/2026-06-19-decor-seasonal-overlay-design.md
//
// Themes (per active preset):
//   'snow'     — falling snowflakes + crossing motif. Engine: src/lib/decor-snow.ts.
//   'mourning' — whole viewport desaturated to grayscale (national mourning).
//
// Everything is built at runtime, so off-season / opted-out pages ship one empty <div>.
// Styles are global but ID-namespaced (#decor-root), so JS-injected nodes match.
//
// Snow art = Tabler Icons — Copyright (c) 2020-2026 Paweł Kuna — MIT.
//   https://github.com/tabler/tabler-icons  (notice: web/THIRD-PARTY-NOTICES.md).

interface Props {
  /** Render the overlay on this page (default true). Pass false to opt a page out. */
  enabled?: boolean;
}
const { enabled = true } = Astro.props;
---

{enabled && <div id="decor-root" aria-hidden="true"></div>}

<style is:global>
  #decor-root { position: fixed; inset: 0; z-index: 30; pointer-events: none; }
  #decor-root .decor-snow { position: absolute; inset: 0; overflow: hidden; }
  #decor-root .decor-flake { position: absolute; top: -24px; display: block; animation: decor-fall linear infinite; }
  #decor-root .decor-flake svg { width: 100%; height: 100%; display: block; }
  @keyframes decor-fall {
    0% { transform: translate(0, -24px) rotate(0deg); }
    100% { transform: translate(var(--sway, 0), 110vh) rotate(var(--spin, 200deg)); }
  }
  /* crossing motif */
  #decor-motif { position: absolute; bottom: 16px; left: 0; color: rgba(20, 56, 107, .82); transform: translateX(-160px); }
  #decor-motif svg { width: 46px; height: 46px; display: block; }
  #decor-motif.run { animation: decor-cross 20s linear forwards; will-change: transform; }
  #decor-motif .decor-bob { display: inline-block; animation: decor-bob 2.6s ease-in-out infinite; }
  @keyframes decor-cross {
    0% { transform: translateX(-160px); }
    100% { transform: translateX(calc(100vw + 160px)); }
  }
  @keyframes decor-bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-7px); }
  }
  @media (max-width: 767px) {
    #decor-motif { bottom: calc(84px + env(safe-area-inset-bottom)); }
  }
  /* mourning grayscale is set as an inline style in JS (the CSS minifier strips
     backdrop-filter; inline styles bypass the build). The class only exempts the
     mourning overlay from the reduced-motion hide below. */
  /* reduced-motion kills the snow (motion), but NOT mourning (static grayscale). */
  @media (prefers-reduced-motion: reduce) {
    #decor-root:not(.decor-mourning) { display: none !important; }
  }
</style>

<script>
  import { DECOR_PRESETS, resolveActiveDecor, todayInBangkok } from '../lib/decor';
  import { runSnow } from '../lib/decor-snow';

  const root = document.getElementById('decor-root');
  if (root) {
    const mq = window.matchMedia('(prefers-reduced-motion: reduce)');
    const override = new URLSearchParams(location.search).get('decor');
    const locale = (document.documentElement.lang || 'th') as 'th' | 'en' | 'zh-cn';
    const active = resolveActiveDecor(DECOR_PRESETS, todayInBangkok(), locale, override);

    if (!active) {
      root.remove();
    } else if (active.theme === 'mourning') {
      // Topmost pointer-through overlay; backdrop-filter greyscales the whole
      // viewport (incl. fixed header/CTA) without breaking their positioning.
      // Set inline (build strips backdrop-filter from stylesheets). Static → keeps
      // the .decor-mourning class so the reduced-motion belt won't hide it.
      root.classList.add('decor-mourning');
      root.style.zIndex = '2147483000';
      root.style.setProperty('backdrop-filter', 'grayscale(1)');
      root.style.setProperty('-webkit-backdrop-filter', 'grayscale(1)');
    } else if (mq.matches) {
      root.remove(); // snow is motion → respect reduced-motion
    } else {
      runSnow(root, active.density || 'medium', active.motifs || []);
      mq.addEventListener('change', (e) => {
        if (e.matches) document.getElementById('decor-root')?.remove();
      });
    }
  }
</script>
