---
import Section from '~/components/ui/Section.astro';
import SectionHeading from '~/components/ui/SectionHeading.astro';
import ReviewCard from '~/components/cards/ReviewCard.astro';
import Image from '~/components/ui/Image.astro';
interface Props {
  heading: string;
  reviews: { quote: string; name: string; stars: number }[];
  video: { poster: { src?: string; alt: string; label?: string }; src?: string; label: string };
}
const { heading, reviews, video } = Astro.props;
---
<Section tone="paper">
  <SectionHeading title={heading} align="center" />
  <div class="mt-8 grid gap-6 lg:grid-cols-3">
    <div class="lg:col-span-2 grid gap-4 sm:grid-cols-2" data-reveal-stagger>
      {reviews.map((r) => <div data-reveal><ReviewCard quote={r.quote} name={r.name} stars={r.stars} /></div>)}
    </div>
    <div class="w-full" data-reveal>
      {video.src ? (
        <video controls preload="none" playsinline poster={video.poster.src} width="1280" height="1280"
               class="rounded-2xl border border-brand-neutral-200 bg-black w-full aspect-square">
          <source src={video.src} type="video/mp4" />
        </video>
      ) : (
        <Image src={video.poster.src} alt={video.poster.alt} label={video.poster.label} width={300} height={300} />
      )}
      <p class="mt-2 text-center text-sm text-brand-neutral-500">{video.label}</p>
    </div>
  </div>
</Section>
