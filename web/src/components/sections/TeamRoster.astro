---
import Section from '~/components/ui/Section.astro';
import SectionHeading from '~/components/ui/SectionHeading.astro';
import ProfileCard from '~/components/cards/ProfileCard.astro';
import { TEAM_MOCK, type Locale } from '~/data/team-mock';

interface Props {
  heading: string;
}
const { heading } = Astro.props;

const lang = (Astro.currentLocale ?? 'th') as Locale;
const t = ({
  th:      { subtitle: 'ทีมทันตแพทย์เฉพาะทางหลากสาขา ดูแลคุณอย่างใกล้ชิด', chip: 'ทีมทันตแพทย์เฉพาะทาง', view: 'ดูโปรไฟล์' },
  en:      { subtitle: 'A multidisciplinary team of specialist dentists', chip: 'Specialist dental team', view: 'View profile' },
  'zh-cn': { subtitle: '多学科专科牙医团队，贴心照护', chip: '专科牙医团队', view: '查看简介' },
} as const)[lang] ?? { subtitle: '', chip: '', view: 'View profile' };

const roster = TEAM_MOCK.map((d) => ({
  key: d.key,
  license: d.license,
  photo: d.photo,
  href: d.href,
  name: d.name[lang],
  specialty: d.specialty[lang],
}));

const topSet = roster.slice(0, 10);
const bottomSet = roster.slice(10, 20);
---
<Section>
  <div data-reveal class="text-center">
    <span class="inline-flex items-center rounded-full bg-brand-primary-soft px-3 py-1 text-xs font-semibold text-brand-primary-deep">{t.chip}</span>
    <div class="mt-3"><SectionHeading title={heading} subtitle={t.subtitle} align="center" /></div>
  </div>

  <div data-team-marquee class="mt-8 overflow-hidden">
    <div data-row="top" class="flex will-change-transform">
      {topSet.map((d) => <ProfileCard name={d.name} license={d.license} specialty={d.specialty} photo={d.photo} href={d.href} viewLabel={t.view} dkey={d.key} />)}
      {topSet.map((d) => <ProfileCard name={d.name} license={d.license} specialty={d.specialty} photo={d.photo} href={d.href} viewLabel={t.view} dkey={d.key} dup />)}
    </div>
    <div data-row="bottom" class="mt-4 flex will-change-transform">
      {bottomSet.map((d) => <ProfileCard name={d.name} license={d.license} specialty={d.specialty} photo={d.photo} href={d.href} viewLabel={t.view} dkey={d.key} />)}
      {bottomSet.map((d) => <ProfileCard name={d.name} license={d.license} specialty={d.specialty} photo={d.photo} href={d.href} viewLabel={t.view} dkey={d.key} dup />)}
    </div>
  </div>
</Section>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const marquee = document.querySelector('[data-team-marquee]');
  const rowTop = marquee?.querySelector('[data-row="top"]') as HTMLElement | null;
  const rowBottom = marquee?.querySelector('[data-row="bottom"]') as HTMLElement | null;

  if (marquee && rowTop && rowBottom && !reduce) {
    const SET = 10;                 // unique cards per row before the duplicate
    const BASE = 0.35;              // px/frame slow base drift
    const DECAY = 0.9;              // boost easing per frame
    const BOOST_CAP = 14;           // max extra px/frame

    // exact repeat distance = offsetLeft of the first duplicate card minus first card
    const measure = (row: HTMLElement) => {
      const ch = row.children;
      return (ch[SET] as HTMLElement).offsetLeft - (ch[0] as HTMLElement).offsetLeft;
    };

    let wTop = measure(rowTop), wBottom = measure(rowBottom);
    window.addEventListener('resize', () => { wTop = measure(rowTop); wBottom = measure(rowBottom); }, { passive: true });

    let distTop = 0;
    // half-card phase stagger on bottom row so cards don't vertically align
    let distBottom = wBottom > 0 ? (wBottom / SET) / 2 : 0;

    let boost = 0, lastY = window.scrollY;
    window.addEventListener('scroll', () => {
      const y = window.scrollY;
      boost = Math.min(boost + Math.abs(y - lastY) * 0.35, BOOST_CAP);
      lastY = y;
    }, { passive: true });

    let running = false, rafId = 0;
    const frame = () => {
      const v = BASE + boost;
      boost *= DECAY;
      if (boost < 0.01) boost = 0;

      distTop += v;
      distBottom += v;

      // top row drifts RIGHT (positive translateX that wraps back)
      if (wTop > 0)    rowTop.style.transform    = `translate3d(${(((distTop % wTop) - wTop)).toFixed(1)}px,0,0)`;
      // bottom row drifts LEFT (negative translateX that wraps back)
      if (wBottom > 0) rowBottom.style.transform = `translate3d(${((-(distBottom % wBottom))).toFixed(1)}px,0,0)`;

      rafId = requestAnimationFrame(frame);
    };

    new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting && !running) {
          running = true;
          rafId = requestAnimationFrame(frame);
        } else if (!e.isIntersecting && running) {
          running = false;
          cancelAnimationFrame(rafId);
        }
      });
    }, { threshold: 0 }).observe(marquee);
  }
</script>
