---
import Section from '~/components/ui/Section.astro';
import SectionHeading from '~/components/ui/SectionHeading.astro';
import ProfileCard from '~/components/cards/ProfileCard.astro';
import { TEAM_MOCK, type Locale } from '~/data/team-mock';

interface Props {
  heading: string;
}
const { heading } = Astro.props;

const lang = (Astro.currentLocale ?? 'th') as Locale;
const t = ({
  th:      { subtitle: 'ทีมทันตแพทย์เฉพาะทางหลากสาขา ดูแลคุณอย่างใกล้ชิด', chip: 'ทีมทันตแพทย์เฉพาะทาง', view: 'ดูโปรไฟล์' },
  en:      { subtitle: 'A multidisciplinary team of specialist dentists', chip: 'Specialist dental team', view: 'View profile' },
  'zh-cn': { subtitle: '多学科专科牙医团队，贴心照护', chip: '专科牙医团队', view: '查看简介' },
} as const)[lang] ?? { subtitle: '', chip: '', view: 'View profile' };

const roster = TEAM_MOCK.map((d) => ({
  key: d.key,
  license: d.license,
  photo: d.photo,
  href: d.href,
  name: d.name[lang],
  specialty: d.specialty[lang],
}));

const topSet = roster.slice(0, 10);
const bottomSet = roster.slice(10, 20);
---
<Section>
  <div data-reveal class="text-center">
    <span class="inline-flex items-center rounded-full bg-brand-primary-soft px-3 py-1 text-xs font-semibold text-brand-primary-deep">{t.chip}</span>
    <div class="mt-3"><SectionHeading title={heading} subtitle={t.subtitle} align="center" /></div>
  </div>

  <div data-team-marquee class="mt-8 overflow-hidden">
    <div data-row="top" class="flex will-change-transform">
      {topSet.map((d) => <ProfileCard name={d.name} license={d.license} specialty={d.specialty} photo={d.photo} href={d.href} viewLabel={t.view} dkey={d.key} />)}
      {topSet.map((d) => <ProfileCard name={d.name} license={d.license} specialty={d.specialty} photo={d.photo} href={d.href} viewLabel={t.view} dkey={d.key} dup />)}
    </div>
    <div data-row="bottom" class="mt-4 flex will-change-transform">
      {bottomSet.map((d) => <ProfileCard name={d.name} license={d.license} specialty={d.specialty} photo={d.photo} href={d.href} viewLabel={t.view} dkey={d.key} />)}
      {bottomSet.map((d) => <ProfileCard name={d.name} license={d.license} specialty={d.specialty} photo={d.photo} href={d.href} viewLabel={t.view} dkey={d.key} dup />)}
    </div>
  </div>
</Section>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const marquee = document.querySelector('[data-team-marquee]');
  const rowEls = marquee ? (Array.from(marquee.querySelectorAll('[data-row]')) as HTMLElement[]) : [];
  if (marquee && rowEls.length && !reduce) {
    const SET = 10;
    const BASE = 0.315;      // idle drift (−10%)
    const DECAY = 0.9;
    const BOOST_K = 0.245;   // scroll → speed (−30%)
    const BOOST_CAP = 10;    // (−30%)
    const mod = (n: number, m: number) => ((n % m) + m) % m;

    const rows = rowEls.map((el) => {
      const measure = () => {
        const a = el.children[0] as HTMLElement | undefined;
        const b = el.children[SET] as HTMLElement | undefined;
        return a && b ? b.offsetLeft - a.offsetLeft : 0;
      };
      const w = measure();
      const dirSign = el.getAttribute('data-row') === 'top' ? 1 : -1; // top drifts right, bottom left
      return { el, dirSign, measure, w, dist: dirSign < 0 && w ? w / SET / 2 : 0, hover: false, down: false, lastX: 0, dragged: false };
    });

    let boost = 0, lastY = window.scrollY, running = false, rafId = 0;
    window.addEventListener('resize', () => rows.forEach((r) => { r.w = r.measure(); }), { passive: true });
    window.addEventListener('scroll', () => {
      const y = window.scrollY;
      boost = Math.min(boost + Math.abs(y - lastY) * BOOST_K, BOOST_CAP);
      lastY = y;
    }, { passive: true });

    rows.forEach((r) => {
      r.el.style.touchAction = 'pan-y'; // vertical page scroll stays; horizontal = our drag
      r.el.addEventListener('pointerenter', (e) => { if ((e as PointerEvent).pointerType === 'mouse') r.hover = true; });
      r.el.addEventListener('pointerleave', (e) => { if ((e as PointerEvent).pointerType === 'mouse') r.hover = false; });
      r.el.addEventListener('pointerdown', (e) => {
        const pe = e as PointerEvent;
        r.down = true; r.dragged = false; r.lastX = pe.clientX;
        try { r.el.setPointerCapture(pe.pointerId); } catch (_) {}
      });
      r.el.addEventListener('pointermove', (e) => {
        if (!r.down) return;
        const pe = e as PointerEvent;
        const dx = pe.clientX - r.lastX; r.lastX = pe.clientX;
        r.dist += r.dirSign * dx; // content follows the finger
        if (Math.abs(dx) > 1) r.dragged = true;
      });
      const release = (e: Event) => {
        if (!r.down) return;
        r.down = false;
        try { r.el.releasePointerCapture((e as PointerEvent).pointerId); } catch (_) {}
      };
      r.el.addEventListener('pointerup', release);
      r.el.addEventListener('pointercancel', release);
      r.el.addEventListener('click', (e) => { if (r.dragged) { e.preventDefault(); e.stopPropagation(); r.dragged = false; } }, true);
    });

    const frame = () => {
      const v = BASE + boost;
      boost *= DECAY; if (boost < 0.01) boost = 0;
      rows.forEach((r) => {
        if (!r.hover && !r.down) r.dist += v;
        if (!r.w) return;
        const m = mod(r.dist, r.w);
        r.el.style.transform = `translate3d(${(r.dirSign > 0 ? m - r.w : -m).toFixed(1)}px,0,0)`;
      });
      rafId = requestAnimationFrame(frame);
    };
    new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting && !running) { running = true; rafId = requestAnimationFrame(frame); }
        else if (!e.isIntersecting && running) { running = false; cancelAnimationFrame(rafId); }
      });
    }, { threshold: 0 }).observe(marquee);
  }
</script>
