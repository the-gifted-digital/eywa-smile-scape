---
import Section from '~/components/ui/Section.astro';
import SectionHeading from '~/components/ui/SectionHeading.astro';
import ProfileCard from '~/components/cards/ProfileCard.astro';
import { TEAM_MOCK, type Locale } from '~/data/team-mock';

interface Props {
  heading: string;
}
const { heading } = Astro.props;

const lang = (Astro.currentLocale ?? 'th') as Locale;
const t = ({
  th:      { subtitle: 'ทีมทันตแพทย์เฉพาะทางหลากสาขา ดูแลคุณอย่างใกล้ชิด', chip: 'ทีมทันตแพทย์เฉพาะทาง', view: 'ดูโปรไฟล์' },
  en:      { subtitle: 'A multidisciplinary team of specialist dentists', chip: 'Specialist dental team', view: 'View profile' },
  'zh-cn': { subtitle: '多学科专科牙医团队，贴心照护', chip: '专科牙医团队', view: '查看简介' },
} as const)[lang] ?? { subtitle: '', chip: '', view: 'View profile' };

const roster = TEAM_MOCK.map((d) => ({
  key: d.key,
  license: d.license,
  photo: d.photo,
  href: d.href,
  name: d.name[lang],
  specialty: d.specialty[lang],
}));

const top = roster.slice(0, 6);
const bottom = roster.slice(6, 12);
---
<Section>
  <div data-reveal class="text-center">
    <span class="inline-flex items-center rounded-full bg-brand-primary-soft px-3 py-1 text-xs font-semibold text-brand-primary-deep">{t.chip}</span>
    <div class="mt-3"><SectionHeading title={heading} subtitle={t.subtitle} align="center" /></div>
  </div>

  <div data-team-marquee class="mt-8 overflow-hidden">
    <div data-row="top" class="flex gap-4 will-change-transform">
      {top.map((d) => (
        <ProfileCard
          name={d.name}
          license={d.license}
          specialty={d.specialty}
          photo={d.photo}
          href={d.href}
          viewLabel={t.view}
          dkey={d.key}
        />
      ))}
    </div>
    <div data-row="bottom" class="mt-4 flex gap-4 pl-12 will-change-transform">
      {bottom.map((d) => (
        <ProfileCard
          name={d.name}
          license={d.license}
          specialty={d.specialty}
          photo={d.photo}
          href={d.href}
          viewLabel={t.view}
          dkey={d.key}
        />
      ))}
    </div>
  </div>

  <script type="application/json" data-team-pool set:html={JSON.stringify(roster)}></script>
</Section>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const marquee = document.querySelector('[data-team-marquee]');
  const rowTop = marquee?.querySelector('[data-row="top"]') as HTMLElement | null;
  const rowBottom = marquee?.querySelector('[data-row="bottom"]') as HTMLElement | null;

  // (A) scroll-coupled horizontal drift: top → right / bottom → left as you scroll down; reverses on scroll up.
  if (marquee && rowTop && rowBottom && !reduce) {
    const AMP = 90;
    let ticking = false;
    const onScroll = () => {
      const rect = (marquee as HTMLElement).getBoundingClientRect();
      const vh = window.innerHeight || 1;
      let p = (vh - rect.top) / (vh + rect.height);
      p = Math.max(0, Math.min(1, p));
      const x = (p - 0.5) * 2 * AMP;
      rowTop.style.transform = `translate3d(${x.toFixed(1)}px,0,0)`;
      rowBottom.style.transform = `translate3d(${(-x).toFixed(1)}px,0,0)`;
      ticking = false;
    };
    window.addEventListener('scroll', () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(onScroll);
      }
    }, { passive: true });
    onScroll();
  }

  // (B) auto-crossfade: every 3s, fade one visible card to a different doctor from the 20-pool.
  const poolEl = document.querySelector('[data-team-pool]');
  const cards = Array.from(document.querySelectorAll('[data-card]')) as HTMLElement[];
  if (poolEl && cards.length && !reduce) {
    const pool = JSON.parse(poolEl.textContent || '[]') as Array<{
      key: string;
      license: string;
      photo: string;
      href: string;
      name: string;
      specialty: string;
    }>;
    const shown = new Set(cards.map((c) => c.dataset.key));
    setInterval(() => {
      const card = cards[Math.floor(Math.random() * cards.length)];
      const candidates = pool.filter((d) => !shown.has(d.key));
      if (!candidates.length) return;
      const next = candidates[Math.floor(Math.random() * candidates.length)];
      const prevKey = card.dataset.key!;
      card.style.transition = 'opacity .45s ease';
      card.style.opacity = '0';
      setTimeout(() => {
        card.dataset.key = next.key;
        card.setAttribute('href', next.href);
        (card.querySelector('[data-card-name]') as HTMLElement).textContent = next.name;
        (card.querySelector('[data-card-license]') as HTMLElement).textContent = next.license;
        (card.querySelector('[data-card-specialty]') as HTMLElement).textContent = next.specialty;
        const img = card.querySelector('[data-card-photo]') as HTMLImageElement;
        img.src = next.photo;
        img.alt = next.name;
        shown.delete(prevKey);
        shown.add(next.key);
        card.style.opacity = '1';
      }, 460);
    }, 3000);
  }
</script>
