---
import Icon from '~/components/ui/Icon.astro';

interface Props { items: { label: string; icon?: string }[]; }
const { items } = Astro.props;
const iconName = (name?: string) => (['star', 'train', 'percent', 'scan'] as const).find((icon) => icon === name) ?? 'check';
---
<div class="trustbar relative border-b border-brand-neutral-200 bg-brand-paper">
  <ul
    data-reveal
    class="mx-auto grid max-w-6xl grid-cols-2 auto-rows-fr px-4 py-3 text-xs font-medium text-brand-anchor sm:text-sm lg:grid-cols-4 lg:py-5"
  >
    {items.map((it) => (
      <li class="trustbar-item flex min-w-0 items-center gap-3 border-brand-neutral-200 px-3 py-3 lg:justify-center lg:px-4 lg:py-0">
        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-brand-ice text-brand-primary-deep" aria-hidden="true">
          <Icon name={iconName(it.icon)} class="h-5 w-5" />
        </span>
        <span class="min-w-0 leading-relaxed">{it.label}</span>
      </li>
    ))}
  </ul>
</div>

<style>
  /* Dividers follow the two-column mobile grid and the four-column desktop row. */
  .trustbar-item:nth-child(even) { border-left-width: 1px; }
  .trustbar-item:nth-child(n + 3) { border-top-width: 1px; }
  @media (min-width: 1024px) {
    .trustbar-item:nth-child(n + 3) { border-top-width: 0; }
    .trustbar-item + .trustbar-item { border-left-width: 1px; }
  }
</style>
