---
import Section from '~/components/ui/Section.astro';
import SectionHeading from '~/components/ui/SectionHeading.astro';
import Image from '~/components/ui/Image.astro';
interface Props {
  heading: string;
  enabled?: boolean; // compliance gate
  note?: string;
  items: { image: { src?: string; alt: string; label?: string }; caption: string }[];
}
const { heading, enabled = true, note, items } = Astro.props;
const lbLabel = Astro.currentLocale === 'th' ? 'ภาพผลลัพธ์ขนาดเต็ม' : Astro.currentLocale === 'zh-cn' ? '查看完整图片' : 'View full-size image';
const loop = [...items, ...items]; // duplicate for seamless desktop carousel
---
{enabled && (
  <Section>
    <div data-reveal><SectionHeading title={heading} align="center" /></div>

    {/* Mobile (<md): grid + lightbox (unchanged behavior) */}
    <div class="md:hidden mt-8 grid grid-cols-2 gap-3" data-reveal-stagger>
      {items.map((it, i) => (
        <figure data-reveal class={`relative overflow-hidden rounded-xl border border-brand-neutral-200 bg-brand-neutral-0 u-hover ${i === 0 ? 'col-span-2' : ''}`}>
          <Image src={it.image.src} alt={it.image.alt} label={it.image.label} width={500} height={500} rounded={false} class="ba-img cursor-zoom-in aspect-square" />
          <figcaption class="pointer-events-none absolute top-2 left-2 rounded-full bg-brand-anchor/85 px-2.5 py-0.5 text-[11px] font-medium text-brand-neutral-0">{it.caption}</figcaption>
        </figure>
      ))}
    </div>

    {/* Desktop (md+): auto-loop carousel, right→left; pause on hover/press; click → lightbox */}
    <div data-ba-carousel data-reveal class="hidden md:block mt-8 overflow-hidden">
      <div data-ba-track class="flex will-change-transform">
        {loop.map((it, i) => (
          <figure
            class="relative mr-4 w-[clamp(300px,30vw,400px)] shrink-0 overflow-hidden rounded-2xl border border-brand-neutral-200 bg-brand-neutral-0"
            aria-hidden={i >= items.length ? 'true' : undefined}
          >
            <Image src={it.image.src} alt={it.image.alt} label={it.image.label} width={600} height={600} rounded={false} class={`aspect-square ${i < items.length ? 'ba-img cursor-zoom-in' : ''}`} />
            <figcaption class="pointer-events-none absolute top-3 left-3 rounded-full bg-brand-anchor/85 px-3 py-1 text-xs font-medium text-brand-neutral-0">{it.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>

    {note && <p class="mt-4 text-center text-xs text-brand-neutral-400">{note}</p>}

    <div id="ba-lightbox" class="ba-lightbox" aria-hidden="true" role="dialog" aria-modal="true" aria-label={lbLabel}>
      <button type="button" class="ba-close" aria-label="close">✕</button>
      <img class="ba-lightbox-img" alt="" />
    </div>
  </Section>
)}
<style>
  .ba-lightbox { position: fixed; inset: 0; z-index: 100; display: none; align-items: center; justify-content: center; background: rgba(11,26,46,0.93); padding: 20px; }
  .ba-lightbox.open { display: flex; }
  .ba-lightbox-img { max-width: 100%; max-height: 88vh; width: auto; height: auto; border-radius: 12px; box-shadow: 0 16px 50px rgba(0,0,0,0.55); animation: ba-zoom 0.22s ease; }
  @keyframes ba-zoom { from { transform: scale(0.94); opacity: 0; } to { transform: scale(1); opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .ba-lightbox-img { animation: none; } }
  .ba-close { position: absolute; top: 14px; right: 14px; width: 44px; height: 44px; border-radius: 9999px; background: rgba(255,255,255,0.16); color: #fff; font-size: 20px; border: none; cursor: pointer; line-height: 1; }
  .ba-close:hover { background: rgba(255,255,255,0.28); }
</style>
<script>
  // ---- Shared pause flag (module scope so lightbox close() can unfreeze carousel) ----
  let baPaused = false;

  // ---- Lightbox (attaches to all .ba-img: mobile grid + desktop carousel real set) ----
  const lb = document.getElementById('ba-lightbox');
  if (lb) {
    const lbImg = lb.querySelector('.ba-lightbox-img') as HTMLImageElement;
    const open = (src: string, alt: string) => {
      lbImg.src = src; lbImg.alt = alt || '';
      lb.classList.add('open'); lb.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      (lb.querySelector('.ba-close') as HTMLElement | null)?.focus();
    };
    const close = () => {
      lb.classList.remove('open'); lb.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = ''; lbImg.src = ''; baPaused = false;
    };
    document.querySelectorAll('.ba-img').forEach((img) => {
      img.addEventListener('click', () => open((img as HTMLImageElement).currentSrc || (img as HTMLImageElement).src, (img as HTMLImageElement).alt));
    });
    lb.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t === lb || t.classList.contains('ba-close')) close();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && lb.classList.contains('open')) close();
    });
  }

  // ---- Desktop carousel: seamless leftward auto-loop; pause on hover/press ----
  const reduceC = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const carEl = document.querySelector('[data-ba-carousel]');
  const track = carEl?.querySelector('[data-ba-track]') as HTMLElement | null;
  if (carEl && track && track.children.length > 1 && !reduceC) {
    const SET = track.children.length / 2;
    const mod = (n: number, m: number) => ((n % m) + m) % m;
    const measure = () => {
      const a = track.children[0] as HTMLElement | undefined;
      const b = track.children[SET] as HTMLElement | undefined;
      return a && b ? b.offsetLeft - a.offsetLeft : 0;
    };
    let w = measure(), dist = 0, running = false, rafId = 0;
    const BASE = 0.35; // slow glam drift
    window.addEventListener('resize', () => { w = measure(); }, { passive: true });
    track.style.touchAction = 'pan-y';
    track.addEventListener('pointerenter', (e) => { if ((e as PointerEvent).pointerType === 'mouse') baPaused = true; });
    track.addEventListener('pointerleave', (e) => { if ((e as PointerEvent).pointerType === 'mouse') baPaused = false; });
    track.addEventListener('pointerdown', () => { baPaused = true; });
    const release = () => { baPaused = false; };
    track.addEventListener('pointerup', release);
    track.addEventListener('pointercancel', release);
    const frame = () => {
      if (!baPaused) dist += BASE;
      if (w > 0) track.style.transform = `translate3d(${(-mod(dist, w)).toFixed(1)}px,0,0)`; // leftward
      rafId = requestAnimationFrame(frame);
    };
    new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting && !running) { running = true; rafId = requestAnimationFrame(frame); }
        else if (!e.isIntersecting && running) { running = false; cancelAnimationFrame(rafId); }
      });
    }, { threshold: 0 }).observe(carEl);
  }
</script>
