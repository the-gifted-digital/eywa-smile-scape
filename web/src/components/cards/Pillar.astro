---
import Icon from '~/components/ui/Icon.astro';

interface Props { icon: string; title: string; body: string; }
const { icon, title, body } = Astro.props;
const iconName = (['implant', 'shield', 'clock', 'heart'] as const).find((name) => name === icon) ?? 'check';
---
<div class="pillar-card flex h-full min-w-0 flex-col rounded-lg border border-brand-neutral-200 bg-brand-neutral-0 p-6 u-hover">
  <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-brand-ice text-brand-primary-deep" aria-hidden="true">
    <Icon name={iconName} class="h-6 w-6" />
  </div>
  <h3 class="mt-5 font-display text-base font-bold leading-snug text-brand-anchor">{title}</h3>
  <p class="mt-2 text-sm text-brand-neutral-700 leading-relaxed">{body}</p>
</div>
