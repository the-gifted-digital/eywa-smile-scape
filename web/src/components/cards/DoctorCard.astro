---
import Image from '~/components/ui/Image.astro';
interface Props {
  name: string;
  role: string;
  index?: number;
  image: { src?: string; alt: string; label?: string };
}
const { name, role, index = 0, image } = Astro.props;
const hasPhoto = !!image.src && !image.src.startsWith('placeholder:');
const tints = [
  'from-brand-primary to-brand-highlight',
  'from-brand-anchor to-brand-primary',
  'from-brand-primary-deep to-brand-primary-soft',
];
const tint = tints[index % tints.length];
---
<div class="u-hover h-full rounded-2xl border border-brand-neutral-200 bg-brand-neutral-0 p-5 text-center">
  <div class="mx-auto h-20 w-20 overflow-hidden rounded-full ring-4 ring-brand-ice">
    {hasPhoto ? (
      <Image src={image.src} alt={image.alt} width={160} height={160} rounded={false} class="h-full w-full object-cover" />
    ) : (
      <div class:list={['flex h-full w-full items-center justify-center bg-gradient-to-br text-brand-neutral-0', tint]} role="img" aria-label={name}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="h-8 w-8" aria-hidden="true">
          <path d="M12 5.5c-1.074 -.586 -2.583 -1.5 -4 -1.5c-2.1 0 -4 1.247 -4 5c0 4.899 1.056 8.41 2.671 10.537c.573 .756 1.97 .521 2.567 -.236c.398 -.505 .819 -1.439 1.262 -2.801c.292 -.771 .892 -1.301 1.5 -1.3c.602 0 1.21 .532 1.5 1.3c.443 1.362 .864 2.295 1.262 2.8c.597 .759 2 .993 2.567 .237c1.615 -2.127 2.671 -5.637 2.671 -10.537c0 -3.74 -1.795 -5 -4 -5c-1.387 0 -2.925 .896 -4 1.5a1.998 1.998 0 0 1 -2 0z" />
        </svg>
      </div>
    )}
  </div>
  <p class="mt-3 font-display font-bold text-brand-anchor leading-snug">{name}</p>
  <p class="mt-0.5 text-sm text-brand-neutral-500">{role}</p>
</div>
