{
  // SmileScape Dental Clinic — Cloudflare Workers Static Assets deploy config.
  // Mirrors eywa-polyvex (live on Cloudflare Workers + Static Assets).
  // Deploy: `npm run build` → `npx wrangler deploy` (serves ./dist as static assets).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eywa-smile-scape",
  "compatibility_date": "2026-06-06",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // Run worker/index.ts on EVERY request (not just non-asset paths) so it can
    // attach the host-scoped `X-Robots-Tag: noindex` belt (SS-DR-017) to asset
    // responses too. Without this, static assets are served directly and bypass
    // the Worker, so the header never lands. At apex cutover the header
    // self-disables (apex ∈ INDEXABLE_HOSTS); you may then set this back to false.
    "run_worker_first": true
  },
  "vars": {
    "N8N_ASSESSMENT_WEBHOOK_URL": "https://nexorcus.app.n8n.cloud/webhook/smilescape-implant-check-lead",
    "RESEND_FROM": "SmileScape <results@smilescapeclinic.com>",
    "RELATED_EMAIL_ENABLED": "false"
  },
  // Parallel-launch phase: Astro served on the `go.` subdomain (Google Ads landing
  // pages) while WordPress keeps serving the apex. DNS is on Cloudflare, so this
  // custom_domain route auto-creates the go.smilescapeclinic.com DNS record + cert.
  // At full cutover, point the apex here too.
  "routes": [{ "pattern": "go.smilescapeclinic.com", "custom_domain": true }],
  "observability": { "enabled": true }
}
